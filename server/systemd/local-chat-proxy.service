[Unit]
Description=LC Chat Transparent HTTP Proxy
After=network.target local-chat-server.service
Wants=local-chat-server.service

[Service]
Type=simple
User=root
Environment=LC_DB_PATH=/opt/local-chat-server/data/sqlite/local_chat.db
ExecStart=/opt/local-chat-server/.venv/bin/python /opt/local-chat-server/app/services/http_proxy.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
