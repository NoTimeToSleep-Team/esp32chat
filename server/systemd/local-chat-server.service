[Unit]
Description=Local Chat Server (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=localchat
Group=localchat
WorkingDirectory=/opt/local-chat-server
EnvironmentFile=/opt/local-chat-server/config/app.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/local-chat-server/.venv/bin/uvicorn app.main:app --host ${LCS_HOST} --port ${LCS_PORT}
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=30
KillSignal=SIGINT
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/local-chat-server/data
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
