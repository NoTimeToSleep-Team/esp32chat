{
  "autonomy_profile_id": "service_assist_only",
  "autonomy_class": "service_edge_assist",
  "requires_persistent_storage": false,
  "offline_behavior": {
    "chat_send": "not_applicable",
    "chat_history": "not_applicable",
    "blog_read": "not_applicable",
    "support_flow": "not_applicable",
    "admin_actions": "limited_local_safe_actions"
  },
  "sync_profile": {
    "queue_mode": "short_telemetry_buffer",
    "pull_mode": "none",
    "transport_expectation": "periodic_server_reconnect"
  },
  "allowed_when_server_unreachable": [
    "watchdog_keepalive",
    "capture_telemetry_snapshot",
    "prepare_safe_shutdown_signal"
  ],
  "not_promised": [
    "user_chat_or_blog_client",
    "independent_server_role",
    "long_term_storage_of_ops_data"
  ]
