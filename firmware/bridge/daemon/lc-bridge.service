[Unit]
Description=LC Bridge daemon (ESP-NOW USB bridge)
After=local-chat-server.service
Wants=local-chat-server.service

[Service]
Type=simple
User=gamecat
ExecStart=/home/gamecat/lc-server/venv/bin/python3 /home/gamecat/lc-server/bridge/lc_bridge_daemon.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
